<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates: install a downloaded update, and (Android 12+) update itself without asking each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".JpApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Jace Passwords"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.JacePasswords">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign in with Jace comes back here: a verified App Link (only this app, signed with the release
                 key, may open it: /.well-known/assetlinks.json on the site)… -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jace-passwords.vercel.app" android:path="/android-auth" />
            </intent-filter>
            <!-- …or, if the link opened in the browser, its "Open Jace Passwords" button (an intent for this app only). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jacepasswords" android:host="auth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".autofill.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.JacePasswords" />

        <service
            android:name=".autofill.JpAutofillService"
            android:exported="true"
            android:label="Jace Passwords"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>

        <receiver android:name=".InstallReceiver" android:exported="false" />
    </application>
</manifest>
